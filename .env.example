PORT=3000
HOST=127.0.0.1

# Optional comma-separated restriction. Empty permits any public HTTP(S) host.
ALLOWED_TARGET_HOSTS=
# Keep false outside local-only development.
ALLOW_PRIVATE_NETWORKS=false

# Optional bearer token for API requests.
API_TOKEN=

ARTIFACT_DIR=work/artifacts
RUN_TIMEOUT_MS=1800000
FORM_READY_TIMEOUT_MS=30000
INITIAL_FORM_READY_TIMEOUT_MS=180000
MAX_CONCURRENT_RUNS=1
MAX_STEPS=10
HEADLESS=true

# Choose exactly one data generator: local, openai, or claude.
# local requires no API key and remains the default for P1/P2.
DATA_GENERATOR_PROVIDER=local

# Required only when DATA_GENERATOR_PROVIDER=openai.
OPENAI_API_KEY=

# Required only when DATA_GENERATOR_PROVIDER=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
