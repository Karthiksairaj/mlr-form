{
  "name": "mlr-form-screenshot-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:ui": "npm --prefix frontend run dev",
    "build": "npm run build:api && npm run build:ui",
    "build:api": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix frontend run build",
    "install:ui": "npm --prefix frontend ci",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "install:browsers": "playwright install chromium"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "openai": "^7.8.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
